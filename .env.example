# === ResearchMind Environment Variables ===
# Copy this file to .env and fill in your values.
# Every model name, limit, and threshold is configurable here (AGENTS.md rule 4).

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct connection string for SQLAlchemy/Alembic (Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- LLM provider ---
# "gemini" uses google-genai with GEMINI_API_KEY.
# "openai_compatible" / "openrouter" / "groq" use any endpoint speaking the
# OpenAI chat-completions API, with LLM_BASE_URL + LLM_API_KEY. Useful as a
# fallback when the Gemini free tier is rate-limited.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# Only needed when LLM_PROVIDER is not "gemini":
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
# Transport retries on rate limits / 5xx.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
# Schema-validation repair attempts for structured output (PRD s6.3).
LLM_STRUCTURED_RETRIES=2

# USD per 1M tokens, written to llm_usage.cost_usd. Leave at 0.0 on a free
# tier — that is the honest cost. A non-zero value overrides the built-in
# pricing table for the selected model.
LLM_PRICE_PER_1M_INPUT=0.0
LLM_PRICE_PER_1M_OUTPUT=0.0

# --- Embeddings ---
# EMBEDDING_DIMENSION must match the vector(N) width in the migration.
# Changing it requires a new Alembic revision.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-api-key-for-clients
DEBUG=true

# --- Research Defaults ---
MAX_ITERATIONS=3
MAX_SOURCES_PER_QUESTION=10
DEFAULT_MODE=quick
CONCURRENCY_CAP=4

# --- Cost Control ---
MAX_TOKENS_PER_RUN=100000
MAX_COST_PER_RUN_USD=1.00

# --- Search ---
SEARCH_REGION=wt-wt
SEARCH_SAFE_SEARCH=off
# In-process result cache (Redis was dropped from the stack). 0 disables it.
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_CACHE_MAX_ENTRIES=512

# --- Page extraction ---
# Redirects are followed manually so every hop is SSRF-checked.
PAGE_MAX_REDIRECTS=5
PAGE_RESPECT_ROBOTS=true
PAGE_ROBOTS_CACHE_TTL_SECONDS=3600
PAGE_USER_AGENT=ResearchMind/1.0 (+https://github.com/researchmind; research bot; respectful crawler)

# --- Timeouts (seconds) ---
AGENT_TIMEOUT=120
SEARCH_TIMEOUT=30
PAGE_EXTRACT_TIMEOUT=15
PAGE_MAX_SIZE_BYTES=1048576

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

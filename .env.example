# === ResearchMind Environment Variables ===
# Copy this file to backend/.env and fill in your values (a repo-root .env
# also works; backend/.env wins). The agents package reads no .env.
# Every model name, limit, and threshold is configurable here (AGENTS.md rule 4).

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct connection string for SQLAlchemy/Alembic (Supabase Dashboard > Settings > Database).
# Uncomment once the database exists: while set, run_mvp.py persists runs to it.
# DATABASE_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
# Connection for LISTEN/NOTIFY: live events and run signals between the API and
# worker processes. Empty uses DATABASE_URL. Supabase's transaction pooler
# (port 6543) cannot LISTEN, so with it set this to the session pooler (same
# host, port 5432) or the direct connection; otherwise processes poll instead.
# DATABASE_LISTEN_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- LLM provider ---
# "gemini" uses google-genai with GEMINI_API_KEY.
# "openai_compatible" / "openrouter" / "groq" use any endpoint speaking the
# OpenAI chat-completions API, with LLM_BASE_URL + LLM_API_KEY. Useful as a
# fallback when the Gemini free tier is rate-limited.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# Only needed when LLM_PROVIDER is not "gemini":
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
# Transport retries on rate limits / 5xx.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
# Longest single retry wait (LLM and embeddings). Free-tier 429s say
# "retry in ~45s"; that wait is honoured up to this cap.
LLM_MAX_RETRY_DELAY=60
# First wait after a 503 "model is experiencing high demand" that names no
# wait (LLM and embeddings); doubles per attempt, so 3 attempts span ~30s.
LLM_OVERLOAD_RETRY_DELAY=10
# Schema-validation repair attempts for structured output (PRD s6.3).
LLM_STRUCTURED_RETRIES=2

# USD per 1M tokens, written to llm_usage.cost_usd. Leave at 0.0 on a free
# tier — that is the honest cost. A non-zero value overrides the built-in
# pricing table for the selected model.
LLM_PRICE_PER_1M_INPUT=0.0
LLM_PRICE_PER_1M_OUTPUT=0.0

# --- Embeddings ---
# EMBEDDING_DIMENSION must match the vector(N) width in the migration.
# Changing it requires a new Alembic revision.
# text-embedding-004 was shut down on 2026-01-14; gemini-embedding-001 is asked
# for EMBEDDING_DIMENSION outputs (it defaults to 3072 otherwise).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Clients send it as the X-API-Key header. Leave empty to disable auth
# (local development only).
API_KEY=your-api-key-for-clients
DEBUG=true
# Browser origins allowed to call the API, comma-separated, or * for any.
# Set your frontend's origin in production.
CORS_ALLOW_ORIGINS=*

# --- API limits ---
MAX_QUESTION_CHARS=2000
# user_context, measured as JSON.
MAX_USER_CONTEXT_BYTES=8192
# Larger request bodies get 413.
MAX_REQUEST_BODY_BYTES=65536
# Highest max_sources a request may ask for.
MAX_SOURCES_LIMIT=50
# Per API key (or client IP without one), over a sliding window. 0 disables.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
# Starting runs is expensive, so it has its own limit.
RATE_LIMIT_RUNS=10

# --- Background runs ---
# Runs are queued in the database; workers claim and execute them
# (python -m app.workers.research_worker, or the one inside the API).
# Runs one worker executes at once; the rest wait in the queue.
MAX_CONCURRENT_RUNS=2
# Queued + running across all workers; beyond this, POST /api/v1/research answers 503.
MAX_PENDING_RUNS=20
# Also run a worker inside the API process, so one container is enough.
# Set false when separate worker processes run (docker-compose.prod.yml).
RUN_WORKER_IN_API=true
# A worker renews its runs' lease every third of this. A run whose lease
# lapses (its worker died) is resumed from its last checkpoint.
RUN_LEASE_SECONDS=60
# How often an idle worker looks for queued runs without being notified.
WORKER_POLL_SECONDS=5
# A run interrupted this many times is failed instead of resumed again.
MAX_RUN_ATTEMPTS=3
# How long cancel/delete wait for a run in the same process to stop.
CANCEL_WAIT_SECONDS=10
# On shutdown a worker hands its runs back (another worker resumes them),
# waiting this long for them to stop.
SHUTDOWN_GRACE_SECONDS=10

# --- Event stream (SSE) ---
# Events are pushed as they are written (across processes via LISTEN/NOTIFY);
# this poll is the fallback when notifications cannot arrive.
SSE_POLL_INTERVAL_SECONDS=2
# Reconnect delay suggested to EventSource clients.
SSE_RETRY_MS=3000

# --- Research Defaults ---
# Research rounds in deep, academic, and decision modes: the first plus up to
# MAX_ITERATIONS - 1 gap-filling rounds. Quick mode always runs one.
MAX_ITERATIONS=3
# Search results requested per query.
MAX_SOURCES_PER_QUESTION=10
# Sources stored per run across all sub-questions (0 = no cap). A request's
# max_sources overrides it for that run.
MAX_SOURCES_PER_RUN=0
# quick (planner, web, synthesizer), deep (adds technical and market
# researchers, claim extraction, fact-checking, contradiction detection, and
# the gap-filling loop), academic (deep plus arXiv / Semantic Scholar papers,
# favoured), or decision (every researcher, market favoured, and a required
# recommendation).
DEFAULT_MODE=quick
CONCURRENCY_CAP=4

# --- Planner ---
# Quick mode.
PLANNER_MIN_SUB_QUESTIONS=2
PLANNER_MAX_SUB_QUESTIONS=5
PLANNER_MAX_QUERIES_PER_SUB_QUESTION=3
# Deep, academic, and decision modes (PRD: 4-8 sub-questions).
PLANNER_VERIFIED_MIN_SUB_QUESTIONS=4
PLANNER_VERIFIED_MAX_SUB_QUESTIONS=8
# Gap-filling rounds: most new sub-questions per round.
PLANNER_MAX_GAP_SUB_QUESTIONS=3

# --- Web research ---
# Pages read per sub-question (failed fetches are replaced from the candidates).
RESEARCH_PAGES_PER_SUB_QUESTION=4
RESEARCH_MAX_FETCH_ATTEMPTS=8
# Token counts are estimated at ~4 characters per token.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
MAX_CHUNKS_PER_SOURCE=8
# Pages with less readable text than this are skipped.
MIN_SOURCE_CHARS=400

# --- Synthesizer ---
SYNTH_TOP_K_PER_SUB_QUESTION=5
SYNTH_MAX_PASSAGES=24
SYNTH_MAX_OUTPUT_TOKENS=8192
# Ignore retrieved passages below this cosine similarity (0 keeps the top-k as is).
SYNTH_MIN_SIMILARITY=0.0
# Verified modes (deep, academic): most claims shown to the model, and the
# lowest claim confidence a report may use.
SYNTH_MAX_CLAIMS=40
SYNTH_MIN_CLAIM_CONFIDENCE=0.0

# --- Academic research (academic mode) ---
# Scholarly indexes queried for papers; the abstracts become sources.
ACADEMIC_SEARCH_PROVIDERS=arxiv,semantic_scholar
# Papers requested per query from each provider.
ACADEMIC_MAX_RESULTS=8
ACADEMIC_SEARCH_TIMEOUT=20
ARXIV_API_URL=https://export.arxiv.org/api/query
# arXiv asks API clients to wait three seconds between requests.
ARXIV_MIN_INTERVAL_SECONDS=3
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1/paper/search
# Optional. Without a key, requests share a public pool that often answers 429;
# the academic researcher then relies on arXiv, or falls back to web search.
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1
# Papers whose abstract is shorter than this are skipped.
MIN_ABSTRACT_CHARS=200

# --- Claim extraction (deep, academic) ---
# Passages retrieved per sub-question and read by the extractor.
CLAIMS_PASSAGES_PER_SUB_QUESTION=5
CLAIMS_MAX_PASSAGES=24
CLAIMS_MAX_PER_SUB_QUESTION=8
CLAIMS_MAX_OUTPUT_TOKENS=4096

# --- Fact checking (deep, academic) ---
# Passages each claim is checked against: its own, then similar passages from
# other sources (independent corroboration or contradiction).
FACT_CHECK_EVIDENCE_PER_CLAIM=4
FACT_CHECK_MIN_SIMILARITY=0.0
# Characters of each passage the fact checker reads (the part nearest the claim).
FACT_CHECK_EXCERPT_CHARS=700
# Claims per model call.
FACT_CHECK_BATCH_SIZE=6
FACT_CHECK_MAX_OUTPUT_TOKENS=4096

# --- Contradiction detection (deep, academic, decision) ---
# Claim pairs at least this similar (cosine) are compared by the model; pairs
# the fact checker linked are always compared. Tune with
# backend/scripts/eval_contradictions.py (it reports candidate recall).
CONTRADICTION_MIN_SIMILARITY=0.7
# Most pairs compared per round (most similar first), claims per topic group,
# and topic groups per model call.
CONTRADICTION_MAX_PAIRS=40
CONTRADICTION_MAX_GROUP_SIZE=6
CONTRADICTION_GROUPS_PER_CALL=4
CONTRADICTION_EXCERPTS_PER_CLAIM=2
CONTRADICTION_MAX_OUTPUT_TOKENS=4096

# --- Sufficiency check and gap-filling loop (deep, academic, decision) ---
# A sub-question is covered with this many usable claims from this many
# independent sites; each one short of that is a gap for the next round.
SUFFICIENCY_MIN_CLAIMS_PER_SUB_QUESTION=2
SUFFICIENCY_MIN_SITES_PER_SUB_QUESTION=2
# When every sub-question is covered, the model judges what is still missing.
SUFFICIENCY_LLM_CHECK=true
SUFFICIENCY_MAX_GAPS=3
SUFFICIENCY_CLAIMS_SHOWN_PER_SUB_QUESTION=6
SUFFICIENCY_MAX_OUTPUT_TOKENS=2048
# Seconds into a run after which no new round starts, per mode, as JSON merged
# over the defaults {"deep": 150, "academic": 180, "decision": 150}; 0 turns a
# mode's deadline off, e.g. LOOP_DEADLINE_SECONDS={"deep": 0}
LOOP_DEADLINE_SECONDS={}

# --- Scoring (PRD s8) ---
# Formulas: agents/researchmind_agents/reliability.py. Domain types come from
# agents/researchmind_agents/data/domains.json. No score is produced by an LLM.
# Base reliability per domain type, as JSON merged over the defaults, e.g.
# RELIABILITY_TYPE_SCORES={"forum": 0.25, "news": 0.75}
RELIABILITY_TYPE_SCORES={}
# Full score up to this age (years), then minus the penalty per extra year,
# never below the floor. Undated sources get the unknown-date factor.
RELIABILITY_RECENCY_FULL_YEARS=3
RELIABILITY_RECENCY_PENALTY_PER_YEAR=0.05
RELIABILITY_RECENCY_FLOOR=0.75
RELIABILITY_UNKNOWN_DATE_FACTOR=0.95
# Papers: up to this bonus for citations (log scale, full at the saturation
# count), plus a bonus when the text describes data or methods.
RELIABILITY_CITATION_BONUS_MAX=0.10
RELIABILITY_CITATION_SATURATION=1000
RELIABILITY_METHODOLOGY_BONUS=0.05
# Claim confidence multiplier per verdict, as JSON merged over the defaults
# (supported 1.0, weak 0.6, mixed 0.35, unsupported 0, unverified 0).
CONFIDENCE_VERDICT_WEIGHTS={}
# The most one fully reliable source establishes on its own; independent
# sources combine by noisy-OR.
CONFIDENCE_SOURCE_WEIGHT=0.8
# Report confidence is reduced by this share at zero sub-question coverage
# (scaled by the uncovered share), and per unresolved contradiction up to the cap.
CONFIDENCE_UNCOVERED_PENALTY=0.5
CONFIDENCE_CONTRADICTION_PENALTY=0.10
CONFIDENCE_CONTRADICTION_PENALTY_CAP=0.5
# Likely causes under which a contradiction is resolved (the claims differ in
# scope, so both can hold). Others (methodology, unexplained) are unresolved.
CONFIDENCE_RESOLVED_CAUSES=conditions,date,version,dataset,definition

# --- Evaluation (M7) ---
# Used only by `python -m researchmind_agents.evals`, never by a research run.
# Model for the LLM-as-judge; empty uses LLM_MODEL. A different (or stronger)
# model avoids the research model grading its own wording.
EVAL_JUDGE_MODEL=
# Cut-offs for Precision@K and Recall@K, comma-separated.
EVAL_RETRIEVAL_K=5,10
# Single-agent RAG baseline: pages it reads for its one search query, and
# passages it retrieves for its answer.
EVAL_RAG_PAGES=6
EVAL_RAG_TOP_K=12
# Answer sentences per judge call; characters of each cited source the judge
# reads (the excerpt most relevant to the sentence).
EVAL_JUDGE_BATCH_SIZE=6
EVAL_JUDGE_EXCERPT_CHARS=700
# Sentences judged per answer; later ones are not scored.
EVAL_MAX_STATEMENTS=40
# Closed-book baseline: distinct cited URLs fetched per answer to check they
# exist and support the sentence.
EVAL_BASELINE_MAX_URLS=20
# Judged citations sampled into spot_check.jsonl for a manual check.
EVAL_SPOT_CHECK_SAMPLE=30
EVAL_MAX_OUTPUT_TOKENS=4096

# --- Cost Control ---
# 0 disables a limit. When research spends (1 - BUDGET_SYNTHESIS_RESERVE) of
# either limit, the run skips to synthesis with what it has.
MAX_TOKENS_PER_RUN=100000
MAX_COST_PER_RUN_USD=1.00
BUDGET_SYNTHESIS_RESERVE=0.2

# --- Search ---
# Search uses the keyless `ddgs` metasearch library. "auto" queries several
# engines and merges results; DuckDuckGo alone is often rate-limited or empty.
# Use a real region code: "wt-wt" breaks the non-DuckDuckGo engines.
SEARCH_BACKEND=auto
SEARCH_REGION=us-en
SEARCH_SAFE_SEARCH=off
# Total tries per query (each retry draws a different engine set).
SEARCH_MAX_ATTEMPTS=2
# In-process result cache (Redis was dropped from the stack). 0 disables it.
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_CACHE_MAX_ENTRIES=512

# --- Page extraction ---
# Redirects are followed manually so every hop is SSRF-checked.
PAGE_MAX_REDIRECTS=5
PAGE_RESPECT_ROBOTS=true
PAGE_ROBOTS_CACHE_TTL_SECONDS=3600
PAGE_USER_AGENT=ResearchMind/1.0 (+https://github.com/researchmind; research bot; respectful crawler)

# --- Timeouts (seconds) ---
# Per-node safety net, long enough to wait out a ~60s free-tier rate limit.
AGENT_TIMEOUT=240
SEARCH_TIMEOUT=30
PAGE_EXTRACT_TIMEOUT=15
PAGE_MAX_SIZE_BYTES=1048576

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Tracing (optional) ---
# LangSmith: each run becomes one trace with a span per graph node, tagged
# with its run_id. Off unless LANGSMITH_TRACING=true and a key is set.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=researchmind
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === ResearchMind Environment Variables ===
# Copy this file to .env and fill in your values.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct connection string for SQLAlchemy/Alembic (find in Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- Models (defaults shown, override if needed) ---
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-api-key-for-clients
DEBUG=true

# --- Research Defaults ---
MAX_ITERATIONS=3
MAX_SOURCES_PER_QUESTION=10
DEFAULT_MODE=quick
CONCURRENCY_CAP=4

# --- Cost Control ---
MAX_TOKENS_PER_RUN=100000
MAX_COST_PER_RUN_USD=1.00

# --- Timeouts (seconds) ---
AGENT_TIMEOUT=120
SEARCH_TIMEOUT=30
PAGE_EXTRACT_TIMEOUT=15
PAGE_MAX_SIZE_BYTES=1048576

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
